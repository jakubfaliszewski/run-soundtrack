{
  "name": "run-soundtrack",
  "version": "1.0.0",
  "description": "Run Soundtrack — map your playlist to your route",
  "private": true,
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install --workspace=client && npm install --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "vite": "^7.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
