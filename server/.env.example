# Server environment — copy to .env and fill in values
# Never commit the .env file itself

# ── Spotify (optional) ───────────────────────────────────────────────────────
# Required for Spotify playlist features.
# Create a free app at https://developer.spotify.com/dashboard
#
# Add the following Redirect URI in your Spotify app settings:
#   http://localhost:3001/api/spotify/callback
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Override if your server or client run on different ports
# SPOTIFY_REDIRECT_URI=http://localhost:3001/api/spotify/callback
# CLIENT_ORIGIN=http://localhost:5173

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3001
