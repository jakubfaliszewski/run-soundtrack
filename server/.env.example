# Server environment — copy to .env and fill in values
# Never commit the .env file itself

# ── Spotify public playlist import (optional) ────────────────────────────────
# Required ONLY for the "paste a public playlist URL" feature.
# User login (OAuth) is now fully client-side and does NOT need these.
#
# Create a free app at https://developer.spotify.com/dashboard
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3001
